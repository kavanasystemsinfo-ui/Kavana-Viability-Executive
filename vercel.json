{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci",
  "buildCommand": "npx nx build web",
  "outputDirectory": "dist/apps/web/browser",
  "rewrites": [
    { "handle": "filesystem" },
    { "source": "/(.*)", "destination": "/index.csr.html" }
  ]
}